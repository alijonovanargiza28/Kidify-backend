# Production example. Never commit real .env files.
NODE_ENV=production
# Hosting PORT wins; PORT_API/PORT_BATCH remain local/legacy fallbacks.
PORT=10000
PORT_API=3007
PORT_BATCH=3001
# Atlas/replica set required for checkout and other multi-document transactions.
MONGO_PROD=
# Optional for local development with NODE_ENV=development:
MONGO_DEV=mongodb://127.0.0.1:27017/kidify?replicaSet=rs0
# At least 32 random characters. Preserve an existing strong secret to keep sessions valid.
SECRET_TOKEN=
# Exact HTTPS frontend origins, comma-separated. No wildcard or URL paths.
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
# none for vercel.app -> onrender.com; lax for same-site custom domains.
AUTH_COOKIE_SAME_SITE=none
# Mount durable storage here; copy the existing uploads/ CONTENTS into it.
UPLOAD_DIR=/var/data/uploads
DELIVERY_FEE=0
BATCH_TIMEZONE=Asia/Tashkent
# Optional AI: persistent Ollama must be reachable from the backend host.
CHAT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Only for CHAT_AI_PROVIDER=openai; server-side secrets only.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
CHAT_AI_USER_DAILY_LIMIT=30
CHAT_AI_GLOBAL_DAILY_LIMIT=300
