PORT_API=3000
PORT_BATCH=3001
NODE_ENV=development
# Seller signup, checkout and other multi-document mutations require a replica set.
MONGO_DEV=mongodb://127.0.0.1:27017/kidify?replicaSet=rs0
MONGO_PROD=
SECRET_TOKEN=replace-with-a-long-random-secret
# Currency is deployment-wide; choose the fee in the same currency as product prices.
DELIVERY_FEE=0
BATCH_TIMEZONE=Asia/Tashkent

# Exact browser origins, comma-separated. Required in production; never use '*'.
CORS_ORIGINS=http://localhost:3000,http://localhost:3016
# lax for same-site frontend/API; none only for cross-site HTTPS production.
AUTH_COOKIE_SAME_SITE=lax
# Access tokens: 15 minutes. Refresh family: absolute 30 days, rotated on use.
# Production requires NODE_ENV=production, HTTPS, a strong SECRET_TOKEN, and MongoDB replica set.

# Backend only. Set both to enable AI; never expose these in Next.js env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Daily request caps; each request makes at most two bounded OpenAI calls.
CHAT_AI_USER_DAILY_LIMIT=30
CHAT_AI_GLOBAL_DAILY_LIMIT=300
# WebSocket Origin validation uses the same CORS_ORIGINS as HTTP.
